---
import BaseLayout from "../layouts/BaseLayout.astro";
import { event } from "../config/event";
---

<BaseLayout title="Contact">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">
      Contact
    </h1>

    <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-700 sm:text-base dark:text-slate-200">
      Reach out to the organizing team or follow iGEM Münster on social media.
    </p>

    <div class="mt-8 grid gap-4 md:mt-10 md:grid-cols-2">
      <div class="card card-dark p-5 sm:p-6">
        <h2 class="text-lg font-bold sm:text-xl">Organizing team</h2>

        <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
          Questions about the event? Contact us via email:
        </p>

        <p class="mt-4 text-sm leading-6 sm:text-base">
          <a
            class="break-all underline hover:text-slate-900 dark:hover:text-white"
            href={"mailto:" + event.contactEmail}
          >
            {event.contactEmail}
          </a>
        </p>

        <div class="mt-8">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
            Socials
          </h3>

          <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-700 dark:text-slate-200">
            <li>
              <span class="font-semibold text-slate-900 dark:text-white">
                Website:
              </span>{" "}
              {event.socials.website ? (
                <a
                  class="underline hover:text-slate-900 dark:hover:text-white"
                  href={event.socials.website}
                  target="_blank"
                  rel="noreferrer"
                >
                  iGEM Münster Website
                </a>
              ) : (
                <span class="text-slate-400"></span>
              )}
            </li>

            <li>
              <span class="font-semibold text-slate-900 dark:text-white">
                Instagram:
              </span>{" "}
              {event.socials.instagram ? (
                <a
                  class="underline hover:text-slate-900 dark:hover:text-white"
                  href={event.socials.instagram}
                  target="_blank"
                  rel="noreferrer"
                >
                  @igem_muenster
                </a>
              ) : (
                <span class="text-slate-400"></span>
              )}
            </li>

            <li>
              <span class="font-semibold text-slate-900 dark:text-white">
              </span>{" "}
              {event.socials.github ? (
                <a
                  class="underline hover:text-slate-900 dark:hover:text-white"
                  href={event.socials.github}
                  target="_blank"
                  rel="noreferrer"
                >
                  iGEM Münster on GitHub
                </a>
              ) : (
                <span class="text-slate-400"></span>
              )}
            </li>
          </ul>
        </div>
      </div>

      <div class="card card-dark p-5 sm:p-6">
        <h2 class="text-lg font-bold sm:text-xl">Interested?</h2>

        <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
          Want to participate with your iGEM team? Leave your details and we will notify you when Indico registration opens.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            class="btn btn-primary w-full text-center sm:w-auto"
            href="/register"
          >
            Get your Ticket
          </a>

          <a
            class="btn btn-secondary w-full text-center sm:w-auto"
            href="/faq"
          >
            Read FAQ
          </a>
        </div>

        <p class="mt-4 text-sm leading-6 text-slate-500 dark:text-slate-400">
          Participation fee is 15 €.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>