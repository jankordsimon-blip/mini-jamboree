---
import BaseLayout from "../layouts/BaseLayout.astro";

const INDICO_URL = "https://indico.uni-muenster.de/event/4129/";
---

<BaseLayout title="Registration">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl md:text-4xl">
      Registration & Tickets
    </h1>

    <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-700 sm:text-base dark:text-slate-200">
      Official registration for the International Junior Jam 2026 is handled via Indico.
      Please read the ticket information below before registering.
    </p>

    <div class="mt-8 grid gap-6 lg:mt-10 lg:grid-cols-5">
      <!-- Main column -->
      <div class="min-w-0 lg:col-span-3">
        <div class="card card-dark p-5 sm:p-6">
          <h2 class="text-lg font-bold sm:text-xl">
            Ticket information
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            The participation fee for the International Junior Jam 2026 is
            <span class="font-semibold text-slate-900 dark:text-white"> 15 €</span>.
            Official
            <span class="font-semibold text-slate-900 dark:text-white">
              registration opens on July 15
            </span>.
            Ticket purchase is handled through Indico.
          </p>

          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            <li>
              Registration is required to participate in the event.
            </li>

            <li>
              Please complete your registration through the official Indico page.
            </li>
            <li>
              Payments can only be done via Credit Card. You can buy multiple tickets, in one purchase. 
            </li>
          </ul>
        </div>

        <div class="card card-dark mt-6 p-5 sm:p-6">
          <h2 class="text-lg font-bold sm:text-xl">
            Deliverables
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            Participating teams are asked to provide a few materials before the event.
            Details on how to submit the deliverables will be announced through our
            WhatsApp community.
          </p>

          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            <li>
              <span class="font-semibold text-slate-900 dark:text-white">
                By July 1:
              </span>{" "}
              Please submit a short project description, a picture of your team and your team logo.
            </li>

            <li>
              <span class="font-semibold text-slate-900 dark:text-white">
                By July 7:
              </span>{" "}
              Please provide your presentation.
            </li>

            <li>
              <span class="font-semibold text-slate-900 dark:text-white">
                At the event:
              </span>{" "}
              Please bring a printed project poster with you.
            </li>
          </ul>
        </div>

        <div class="card card-dark mt-6 p-5 sm:p-6">
          <h2 class="text-lg font-bold sm:text-xl">
            Lunch on Saturday
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            <span class="font-medium text-slate-800 dark:text-slate-200">
              Lunch on Saturday will be provided by Gustav Grün and can be purchased upfront.
            </span>{" "}
            Further information will be provided through our WhatsApp community, but feel free
            to check out their options.
          </p>

          <div class="mt-6">
            <a
              class="btn btn-secondary w-full !py-2.5 text-center sm:w-auto sm:!py-3"
              href="/lunch-options"
            >
              View lunch options
            </a>
          </div>
        </div>

        <div class="card card-dark mt-6 p-5 sm:p-6">
          <h2 class="text-lg font-bold sm:text-xl">
            Register via Indico
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            Use the button below to access the official Indico registration page.
            Your participation is only confirmed after completing the registration process there.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              class="btn btn-primary w-full !py-2.5 text-center sm:w-auto sm:!py-3"
              href={INDICO_URL}
              target="_blank"
              rel="noreferrer"
            >
              Register via Indico
            </a>

            <a
              class="btn btn-secondary w-full !py-2.5 text-center sm:w-auto sm:!py-3"
              href="/program"
            >
              View program
            </a>
          </div>

          <p class="mt-4 text-xs leading-5 text-slate-500 dark:text-slate-400">
            The Indico page opens in a new tab.
          </p>
        </div>
      </div>

      <!-- Side column -->
      <div class="min-w-0 lg:col-span-2">
        <div class="card card-dark p-5 sm:p-6">
          <h2 class="text-lg font-bold sm:text-xl">
            Traveling by train?
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            Participants can use the DB event ticket offer for long-distance travel
            within Germany.
          </p>

          <div class="mt-6">
            <a
              class="btn btn-secondary w-full !py-2.5 text-center sm:w-auto sm:!py-3"
              href="/DBticket"
            >
              View DB ticket offer
            </a>
          </div>
        </div>

        <div class="card card-dark mt-6 p-5 sm:p-6">
          <h2 class="text-lg font-bold sm:text-xl">
            Questions?
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            If you have questions about registration, tickets, or the event, feel free to contact the organizing team.
          </p>

          <div class="mt-6">
            <a
              class="btn btn-secondary w-full !py-2.5 text-center sm:w-auto sm:!py-3"
              href="/contact"
            >
              Contact us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>