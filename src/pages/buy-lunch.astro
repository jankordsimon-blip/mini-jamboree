---
import BaseLayout from "../layouts/BaseLayout.astro";
import LunchOrderForm from "../components/LunchOrderForm";

const PAYPAL_URL = "https://www.paypal.com/pool/9qf9TapnPN?sr=wccr";
const ENDPOINT_URL = "/api/lunch-order";
---

<BaseLayout title="Buy lunch">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl md:text-4xl">
      Buy lunch
    </h1>

    <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-700 sm:text-base dark:text-slate-200">
      Lunch on Saturday will be provided by Gustav Grün. Please choose one lunch option
      and submit your order below.
    </p>

    <div class="mt-8 grid gap-6 lg:mt-10 lg:grid-cols-5">
      <div class="min-w-0 lg:col-span-3">
        <LunchOrderForm
          endpointUrl={ENDPOINT_URL}
          paypalUrl={PAYPAL_URL}
          client:load
        />
      </div>

      <div class="min-w-0 lg:col-span-2">
        <div class="card card-dark p-5 sm:p-6">
          <h2 class="text-lg font-bold sm:text-xl">
            Payment via PayPal
          </h2>

          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            After submitting your order, please transfer the corresponding amount via PayPal.
            Use your full name as the payment note so we can match your payment to your order.
          </p>

          <div class="mt-6">
            <a
              class="btn btn-primary w-full !py-2.5 text-center sm:w-auto sm:!py-3"
              href={PAYPAL_URL}
              target="_blank"
              rel="noreferrer"
            >
              Open PayPal pool
            </a>
          </div>

          <p class="mt-4 text-xs leading-5 text-slate-500 dark:text-slate-400">
            Lunch orders are possible until July 7.
          </p>
        </div>

        <div class="card card-dark mt-6 p-5 sm:p-6">
          <h2 class="text-lg font-bold sm:text-xl">
            Important
          </h2>

          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-600 sm:text-base dark:text-slate-300">
            <li>
              One person can order one lunch.
            </li>

            <li>
              Please use the same full name for your order and your PayPal payment.
            </li>

            <li>
              We will manually match orders and payments.
            </li>
          </ul>
        </div>

        <div class="mt-6">
          <a
            class="btn btn-secondary w-full !py-2.5 text-center sm:w-auto sm:!py-3"
            href="/lunch-options"
          >
            Back to lunch options
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>