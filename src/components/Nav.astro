---
import { event } from "../config/event";

const links = [
  { href: "/DBticket", label: "DB Ticket" },
  { href: "/program", label: "Program" },
  { href: "/venue", label: "Venue" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contact" },
];
---

<header class="border-b border-slate-800 bg-slate-900">
  <nav class="mx-auto max-w-6xl px-4 py-3 sm:px-6 sm:py-4">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="flex min-w-0 items-center gap-3 text-white">
        <img
          src="/Logo_JuniorJam26_hell.png"
          alt="iGEM Münster Junior Jam logo"
          class="h-11 w-auto shrink-0 sm:h-12 md:h-14"
        />

        <span class="truncate text-sm font-semibold tracking-tight sm:text-base">
          International Junior Jam 2026
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center gap-4 text-sm md:flex">
        {links.map((l) => (
          <a
            class="text-slate-200 hover:text-white hover:underline"
            href={l.href}
          >
            {l.label}
          </a>
        ))}

        <a
          class="ml-1 rounded-xl bg-emerald-500 px-4 py-2 font-semibold text-slate-950 hover:bg-emerald-400"
          href="/register"
        >
          Interested
        </a>
      </div>

      <!-- Mobile Navigation -->
      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400">
          Menu
        </summary>

        <div class="absolute right-0 z-50 mt-3 w-56 rounded-2xl border border-slate-700 bg-slate-900 p-3 shadow-xl">
          <div class="flex flex-col gap-2 text-sm">
            {links.map((l) => (
              <a
                class="rounded-lg px-3 py-2 text-slate-200 hover:bg-slate-800 hover:text-white"
                href={l.href}
              >
                {l.label}
              </a>
            ))}

            <a
              class="mt-2 rounded-xl bg-emerald-500 px-3 py-2 text-center font-semibold text-slate-950 hover:bg-emerald-400"
              href="/register"
            >
              Interested
            </a>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>