---
import { event } from "../config/event";

import biozym from "../assets/sponsors/Biozym-logo.jpg";
import carlRoth from "../assets/sponsors/Carl-Roth-logo.png";
import microsynth from "../assets/sponsors/microsynth-ag-seeklogo-2.svg";
import snapgene from "../assets/sponsors/SnapGene Logo.png";
import sparkasse from "../assets/sponsors/Sparkasse.jpeg";
import biorender from "../assets/sponsors/Blue_Square_Reversed-01_1_.svg";
import kws from "../assets/sponsors/Bild 05.05.26 um 14.48.png";
import sartorius from "../assets/sponsors/sartorius-logo-data.svg";
import proteintech from "../assets/sponsors/Logo_Ptg_Main.png";
import neb from "../assets/sponsors/NEB_logo_noTag.svg";
import eppendorf from "../assets/sponsors/logoEppendorf.svg";
import idt from "../assets/sponsors/idt-header-logo2x.png";
import samples from "../assets/sponsors/samples_colour.png";
import merck from "../assets/sponsors/merck.svg";
import promega from "../assets/sponsors/Promega_logo.png";

const sponsors = [
  {
    name: "Eppendorf",
    logo: eppendorf,
  },
  {
    name: "Promega",
    logo: promega,
  },
  {
    name: "Proteintech",
    logo: proteintech,
  },
  {
    name: "Sartorius",
    logo: sartorius,
  },
  {
    name: "MERCK-Sigma Aldrich",
    logo: merck,
  },
  {
    name: "KWS Saat",
    logo: kws,
  },
  {
    name: "Carl Roth",
    logo: carlRoth,
  },
  {
    name: "Integrated DNA Technologies",
    logo: idt,
  },
  {
    name: "Microsynth",
    logo: microsynth,
  },
  {
    name: "SAMPLES",
    logo: samples,
  },
  {
    name: "SnapGene",
    logo: snapgene,
  },
  {
    name: "Biozym",
    logo: biozym,
  },
  {
    name: "Sparkasse Münsterland Ost",
    logo: sparkasse,
  },
  {
    name: "Biorender",
    logo: biorender,
  },
  {
    name: "New England Biolabs",
    logo: neb,
  },
];
---

<footer class="mt-12 border-t border-slate-200 bg-white/70 backdrop-blur md:mt-16 dark:border-slate-800 dark:bg-slate-950/40">
  <div class="mx-auto max-w-6xl px-4 py-10 text-sm leading-6 text-slate-600 sm:px-6 md:py-12 dark:text-slate-300">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xl">
        <p class="font-semibold text-slate-900 dark:text-white">
          {event.name}
        </p>

        <p class="mt-2">
          {event.date} · {event.location}
        </p>

        <p class="mt-4">
          Contact:{" "}
          <a
            class="break-all underline hover:text-slate-900 dark:hover:text-white"
            href={"mailto:" + event.contactEmail}
          >
            {event.contactEmail}
          </a>
        </p>
      </div>

      <div class="w-full md:w-[560px]">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <p class="font-semibold text-slate-900 dark:text-white">
            Supporters
          </p>

          <a
            class="text-xs underline hover:text-slate-900 dark:hover:text-white"
            href="/contact"
          >
            Become a sponsor
          </a>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
          {sponsors.map((s) => (
            <div
              class="flex min-h-[84px] items-center justify-center rounded-xl border border-slate-200 bg-white p-3 transition hover:shadow-md sm:min-h-[96px] sm:p-4 dark:border-slate-800 dark:bg-slate-900"
            >
              <img
                src={s.logo.src}
                alt={s.name}
                class="max-h-10 max-w-full object-contain sm:max-h-14"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>